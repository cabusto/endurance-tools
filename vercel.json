{
  "buildCommand": "pip install -r requirements.txt",
  "devCommand": "uvicorn app.main:app --reload",
  "installCommand": "pip install -r requirements.txt",
  "framework": "python",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}